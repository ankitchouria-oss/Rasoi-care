# Generated by `flutter gen-l10n` (flutter: generate: true in pubspec.yaml)
# from lib/l10n/app_en.arb + app_hi.arb + app_mr.arb — regenerated on every
# pub get/build, never hand-edited. The .arb source files ARE committed.
lib/l10n/app_localizations*.dart

# Android — keep the project, ignore local/generated artifacts only
android/local.properties
android/**/build/
android/.gradle/
android/.kotlin/
android/gradle/wrapper/gradle-wrapper.jar
android/captures/
android/gradlew.log
android/key.properties
# The release keystore (android/app/rasoi-care-upload.jks) IS committed
# deliberately — this environment is ephemeral with no persistent storage
# outside the git repo, so a gitignored/regenerated keystore would
# invalidate every SHA fingerprint registered in Firebase Console and break
# phone-auth SMS delivery across all three apps. Its password is NOT
# committed though — it lives in android/local.properties (gitignored
# above) as KEYSTORE_STORE_PASSWORD/KEYSTORE_KEY_PASSWORD, or in the
# RASOI_KEYSTORE_STORE_PASSWORD/RASOI_KEYSTORE_KEY_PASSWORD environment
# variables — see android/app/build.gradle.kts's signingConfigs.

# iOS/macOS (not scaffolded yet)
ios/
macos/
web/
linux/
windows/
