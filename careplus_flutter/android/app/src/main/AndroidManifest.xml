<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Backend calls (mock today, Firebase/Razorpay later) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Live technician tracking on the booking screen, and "use my current
         location" in the address picker -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Real GPS tracking is wired in (Firestore-backed), but gated behind
         MapsConfig.isConfigured until a Maps API key exists — see
         lib/core/config/maps_config.dart. Either way, don't block install
         on devices without a location radio. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Issue photos on the booking flow -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Booking/job status pushes (Android 13+ requires this explicitly) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- "Call your technician" from the confirmed/tracking screens -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Calling is a convenience action, not core to the app — don't block
         install on devices without telephony (tablets, Wi-Fi-only devices). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:label="Rasoi Care"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Shows LaunchTheme (branded splash) until Flutter draws the first frame -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Flutter's default engine metadata -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Google Maps API key, sourced from android/local.properties via the
             ${mapsApiKey} placeholder in build.gradle.kts — defaults to an
             empty string so the app never crashes from a missing manifest
             entry even before a key exists. See lib/core/config/maps_config.dart
             for the full setup steps and the MAPS_CONFIGURED dart-define that
             actually turns the map UI on. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
    </application>

    <!-- Lets the "Call technician" button and any external-link taps resolve -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
